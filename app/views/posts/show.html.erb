<p style="color: green"><%= notice %></p>

<%= render @post %>

<div>
  <div class="edit-links">
    <%= link_to "投稿の編集", edit_post_path(@post) , class: " btn-edit" %>
    <%= link_to "投稿一覧に戻る", posts_path, class: " btn-allry" %>
  </div>

  <%= button_to "投稿を削除する", @post, method: :delete, class: " btn-danger" %>
</div>
